<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.kalebtavares.nfest.controller.MainController">

    <top>
        <VBox spacing="10.0" styleClass="header-section" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label styleClass="title-label" text="Calculadora ICMS-ST (MS)" />
                        <Button fx:id="btnImportar" mnemonicParsing="false" onAction="#handleImportarXml" styleClass="btn-primary" text="📂 Importar XML NFe" />
                    </children>
                </HBox>
                <HBox spacing="30.0">
                    <children>
                        <VBox>
                            <Label styleClass="label-sub" text="Emitente:" />
                            <Label fx:id="lblEmitente" styleClass="label-value" text="-" />
                        </VBox>
                        <VBox>
                            <Label styleClass="label-sub" text="Destinatário:" />
                            <Label fx:id="lblDestinatario" styleClass="label-value" text="-" />
                        </VBox>
                        <VBox>
                            <Label styleClass="label-sub" text="Chave de Acesso:" />
                            <Label fx:id="lblChave" styleClass="label-value" text="-" />
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabelaProdutos" prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="75.0" text="Cód." />
                <TableColumn fx:id="colNome" prefWidth="250.0" text="Produto" />
                <TableColumn fx:id="colNcm" prefWidth="90.0" text="NCM" />
                <TableColumn fx:id="colValor" prefWidth="100.0" text="Valor (R$)" />
                <TableColumn fx:id="colMva" prefWidth="80.0" text="MVA (%)" />
                <TableColumn fx:id="colIcmsSt" prefWidth="110.0" text="ICMS ST (R$)" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <BorderPane.margin>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
            </BorderPane.margin>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="20.0" styleClass="footer-section" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <VBox alignment="CENTER_RIGHT">
                    <Label styleClass="label-total-desc" text="Total Produtos" />
                    <Label fx:id="lblTotalProdutos" styleClass="label-total-value" text="R$ 0,00" />
                </VBox>
                <VBox alignment="CENTER_RIGHT">
                    <Label styleClass="label-total-desc" text="Total ICMS-ST a Recolher" />
                    <Label fx:id="lblTotalSt" styleClass="label-total-alert" text="R$ 0,00" />
                </VBox>
                <Button fx:id="btnGerarRelatorio" disable="true" mnemonicParsing="false" onAction="#handleGerarRelatorio" styleClass="btn-success" text="📄 Gerar Relatório PDF" />
            </children>
        </HBox>
    </bottom>
</BorderPane>